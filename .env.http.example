# 临时 HTTP 验收部署。首次运行 scripts/start-http.sh 时复制为 .env.http。
# 只需将 NAT 公网端口转发到本机 FRONTEND_PORT；其他端口不要配置公网转发。

INTERVIEW_GUIDE_IMAGE_TAG=http-acceptance
INTERVIEW_GUIDE_DOCKERHUB_REGISTRY=docker.io
FRONTEND_BIND_ADDRESS=0.0.0.0

FRONTEND_PORT=18073

POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_DATABASE_POOL_SIZE=10
APP_DATABASE_MAX_OVERFLOW=0

APP_STORAGE_ACCESS_KEY=interview-http
APP_STORAGE_SECRET_KEY=
APP_STORAGE_BUCKET=interview-guide-http
APP_STORAGE_REGION=us-east-1

# 浏览器经前端 Nginx 同源访问 /api 和 /ws，因此 NAT 域名或公网 IP 无需写入这里。
CORS_ALLOWED_ORIGINS=http://localhost:18073,http://127.0.0.1:18073
LOG_LEVEL=INFO
TZ=Asia/Shanghai
