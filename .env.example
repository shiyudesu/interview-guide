# Provider API Key 在设置页录入。系统首次启动时只创建不带 Key 的百炼 Provider。
# 加密主密钥自动生成并保存在 Compose 的 provider_key 卷中。

# ================================
# 可选配置 - 与根目录 Docker Compose 对齐
# ================================

# PostgreSQL（生产 Compose 内部使用；本地开发 Compose 可按下方端口绑定到 127.0.0.1）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_DATABASE_POOL_SIZE=10
APP_DATABASE_MAX_OVERFLOW=0

# Redis（生产 Compose 内部使用；本地开发 Compose 默认绑定 127.0.0.1:6379）
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / RustFS S3 兼容存储
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=interview-guide
APP_STORAGE_SECRET_KEY=
APP_STORAGE_BUCKET=interview-guide
APP_STORAGE_REGION=us-east-1
APP_STORAGE_PORT=9000
APP_STORAGE_CONSOLE_PORT=9001

# 应用和正式 Compose
INTERVIEW_GUIDE_IMAGE_TAG=local
# Docker Hub 不可达时可替换为可信 pull-through cache 的主机名，不要包含 https://。
INTERVIEW_GUIDE_DOCKERHUB_REGISTRY=docker.io
# 普通一键启动仅允许本机访问；正式 HTTPS 部署仍保持回环，由 Caddy 单独发布 80/443。
FRONTEND_BIND_ADDRESS=127.0.0.1
# 正式 HTTPS 入口。保持 COMPOSE_PROFILES 为空时只启动本机 HTTP 前端；设置为 https 后启用
# Caddy，由备案域名自动向 Let's Encrypt 申请和续期证书。
COMPOSE_PROFILES=
PUBLIC_DOMAIN=
ACME_EMAIL=
TLS_BIND_ADDRESS=0.0.0.0
TLS_HTTP_PORT=80
TLS_HTTPS_PORT=443
# docker-compose.dev.yml 的基础设施默认也只允许本机访问。
DEV_INFRASTRUCTURE_BIND_ADDRESS=127.0.0.1
SERVER_PORT=8080
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# AI 向量维度
APP_AI_EMBEDDING_DIMENSIONS=1024

# 普通知识库 RAG 查询
APP_AI_RAG_REWRITE_ENABLED=true
APP_AI_RAG_SHORT_QUERY_LENGTH=4
APP_AI_RAG_TOPK_SHORT=20
APP_AI_RAG_TOPK_MEDIUM=12
APP_AI_RAG_TOPK_LONG=8
APP_AI_RAG_MIN_SCORE_SHORT=0.18
APP_AI_RAG_MIN_SCORE_DEFAULT=0.28
APP_AI_RAG_HISTORY_ENABLED=true
APP_AI_RAG_HISTORY_MAX_MESSAGES=10
APP_INTERVIEW_FOLLOW_UP_COUNT=1
APP_INTERVIEW_TURN_CONFIDENCE_THRESHOLD=0.65
APP_INTERVIEW_TURN_DECISION_TIMEOUT_SECONDS=20
APP_INTERVIEW_TURN_LEASE_SECONDS=30
APP_INTERVIEW_TURN_CONTEXT_MAX_CHARS=12000
APP_INTERVIEW_TURN_RECENT_COUNT=6
APP_VOICE_TURN_MIN_REMAINING_SECONDS=30

# 语音面试
APP_VOICE_ASR_MODEL=qwen3-asr-flash-realtime
APP_VOICE_TTS_MODEL=qwen3-tts-flash-realtime
# ASR 句间静音阈值，越大越不容易在句中切开
# APP_VOICE_ASR_SILENCE_MS=2000
# APP_VOICE_TTS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# APP_VOICE_TTS_CONNECT_TIMEOUT_SECONDS=5
# APP_VOICE_TTS_TIMEOUT_SECONDS=8
# APP_VOICE_MAX_CONCURRENT_TTS_PER_SESSION=3
