# ================================
# 默认 AI 功能 - 请替换为您的实际密钥
# ================================

# 阿里云百炼 AI (DashScope) - 默认 LLM + Embedding + ASR + TTS
AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# Provider API Key 加密密钥（必填；生产环境请替换为随机长字符串，部署后保持不变）
APP_AI_CONFIG_ENCRYPTION_KEY=change_me_provider_api_key_encryption_key

# ================================
# 文字服务配置
# ================================

# LM Studio 本地 Provider（可选）
PROVIDER_LMSTUDIO_API_KEY=lm-studio

# Moonshot AI / Kimi (https://platform.moonshot.cn/)
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-k2.6

# DeepSeek (https://platform.deepseek.com/)
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 AI / GLM (https://open.bigmodel.cn/)
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# 自定义 OpenAI 兼容 Provider 请在前端设置页添加。
# Provider 表初始化后，修改这里不会覆盖数据库中的配置。

# ================================
# 可选配置 - 与根目录 Docker Compose 对齐
# ================================

# PostgreSQL（compose 默认：库 interview_guide / 用户 postgres / 密码 password / 映射端口 5432）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
APP_DATABASE_POOL_SIZE=10
APP_DATABASE_MAX_OVERFLOW=0

# Redis（compose 映射 6379）
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / RustFS S3 兼容存储
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=interview-guide
APP_STORAGE_REGION=us-east-1
APP_STORAGE_PORT=9000
APP_STORAGE_CONSOLE_PORT=9001

# 应用和正式 Compose
INTERVIEW_GUIDE_IMAGE_TAG=local
SERVER_PORT=8080
FRONTEND_PORT=80
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# AI 模型配置
AI_MODEL=qwen3.7-max
AI_EMBEDDING_MODEL=qwen3.7-text-embedding
APP_AI_EMBEDDING_DIMENSIONS=1024

# 普通知识库 RAG 查询
APP_AI_RAG_REWRITE_ENABLED=true
APP_AI_RAG_SHORT_QUERY_LENGTH=4
APP_AI_RAG_TOPK_SHORT=20
APP_AI_RAG_TOPK_MEDIUM=12
APP_AI_RAG_TOPK_LONG=8
APP_AI_RAG_MIN_SCORE_SHORT=0.18
APP_AI_RAG_MIN_SCORE_DEFAULT=0.28
APP_AI_RAG_HISTORY_ENABLED=true
APP_AI_RAG_HISTORY_MAX_MESSAGES=10
APP_INTERVIEW_FOLLOW_UP_COUNT=1
APP_INTERVIEW_TURN_CONFIDENCE_THRESHOLD=0.65
APP_INTERVIEW_TURN_DECISION_TIMEOUT_SECONDS=20
APP_INTERVIEW_TURN_LEASE_SECONDS=30
APP_INTERVIEW_TURN_CONTEXT_MAX_CHARS=12000
APP_INTERVIEW_TURN_RECENT_COUNT=6
APP_VOICE_TURN_MIN_REMAINING_SECONDS=30

# 0004 自适应面试迁移会清空全部面试数据。确认备份后仅在升级窗口改为 1。
ALLOW_DESTRUCTIVE_INTERVIEW_RESET=0

# 语音面试
APP_VOICE_INTERVIEW_QWEN_ASR_MODEL=qwen3-asr-flash-realtime
APP_VOICE_INTERVIEW_QWEN_TTS_MODEL=qwen3-tts-flash-realtime
# ASR 句间静音阈值，越大越不容易在句中切开
# APP_VOICE_ASR_SILENCE_MS=2000
# APP_VOICE_INTERVIEW_QWEN_TTS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# APP_VOICE_TTS_CONNECT_TIMEOUT_SECONDS=5
# APP_VOICE_TTS_TIMEOUT_SECONDS=8
# APP_VOICE_MAX_CONCURRENT_TTS_PER_SESSION=3
