#!/bin/sh

set -eu

MESSAGE_FILE=${1:?missing commit message file}
MESSAGE=$(git stripspace --strip-comments < "$MESSAGE_FILE")
SUBJECT=$(printf '%s\n' "$MESSAGE" | sed -n '1p')

fail() {
  printf '%s\n' "Invalid commit message: $1" >&2
  printf '%s\n\n' "" >&2
  printf '%s\n' "Expected: type(optional-scope): summary" >&2
  printf '%s\n' "Example: feat(api): preserve legacy response fields" >&2
  exit 1
}

case "$SUBJECT" in
  Merge\ *|Revert\ *|fixup\!\ *|squash\!\ *|amend\!\ *)
    exit 0
    ;;
esac

if ! printf '%s\n' "$SUBJECT" \
  | grep -Eq '^(feat|fix|refactor|perf|test|docs|chore|build|ci|revert)(\([A-Za-z0-9._/-]+\))?!?: .+'; then
  fail "the subject must use an allowed Conventional Commit type"
fi

SECOND_LINE=$(printf '%s\n' "$MESSAGE" | sed -n '2p')
if [ -n "$SECOND_LINE" ]; then
  fail "leave one blank line between the subject and body"
fi

exit 0
