# OpenTrek 校园网比赛实例。首次运行 scripts/start-campus.sh 时复制为 .env.campus。
# 该实例使用独立 Compose 项目名和数据卷，只发布前端 18073 端口。

INTERVIEW_GUIDE_IMAGE_TAG=campus
INTERVIEW_GUIDE_DOCKERHUB_REGISTRY=docker.io
INTERVIEW_GUIDE_BUILD_NETWORK=host
COMPOSE_PROFILES=
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=18073

POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_DATABASE_POOL_SIZE=10
APP_DATABASE_MAX_OVERFLOW=0

APP_STORAGE_ACCESS_KEY=interview-campus
APP_STORAGE_SECRET_KEY=
APP_STORAGE_BUCKET=interview-guide-campus
APP_STORAGE_REGION=us-east-1

APP_COMPETITION_MODE=true
APP_AUTH_ENABLED=true
APP_AUTH_REGISTRATION_ENABLED=false
APP_AUTH_COOKIE_SECURE=false

APP_OPENTREK_ENABLED=true
APP_OPENTREK_RUNTIME_BASE_URL=http://10.128.203.200:80/sfm-agent-studio/sfm-api-gateway/gateway
APP_OPENTREK_APP_KEY=
APP_OPENTREK_WORKSPACE_CODE=

APP_OPENTREK_GENERAL_AGENT_CODE=
APP_OPENTREK_GENERAL_AGENT_VERSION=
APP_OPENTREK_INTERVIEWER_AGENT_CODE=
APP_OPENTREK_INTERVIEWER_AGENT_VERSION=
APP_OPENTREK_EVALUATOR_AGENT_CODE=
APP_OPENTREK_EVALUATOR_AGENT_VERSION=
APP_OPENTREK_RAG_AGENT_CODE=
APP_OPENTREK_RAG_AGENT_VERSION=

APP_OPENTREK_KB_MAPPINGS_JSON='[]'
APP_OPENTREK_CONNECT_TIMEOUT_SECONDS=10
APP_OPENTREK_READ_TIMEOUT_SECONDS=300
APP_OPENTREK_KB_BATCH_SIZE=10
APP_OPENTREK_AGENT_LOCK_FILE=/var/lib/interview-guide/opentrek-agent.lock
APP_OPENTREK_AGENT_MIN_INTERVAL_SECONDS=1
APP_AI_RAG_REWRITE_ENABLED=false
APP_INTERVIEW_TURN_DECISION_TIMEOUT_SECONDS=120
APP_INTERVIEW_TURN_LEASE_SECONDS=150

APP_PROVIDER_OUTBOUND_ALLOWED_HOSTS=10.128.203.200
APP_PROVIDER_OUTBOUND_ALLOWED_NETWORKS=10.128.203.200/32

CORS_ALLOWED_ORIGINS=http://localhost:18073,http://127.0.0.1:18073
LOG_LEVEL=INFO
TZ=Asia/Shanghai
